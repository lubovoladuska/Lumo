# Скопируй этот файл в .env и заполни значения. .env не попадает в git.

# --- LLM (DeepSeek) ---
LUMO_DEEPSEEK_API_KEY=
LUMO_LLM_MODEL=deepseek-chat

# --- Ядро ---
# Общий секрет для подключения клиентов. Придумай длинную случайную строку.
LUMO_TOKEN=change-me
LUMO_PORT=8765
# true — принимать подключения из сети (понадобится для телефона). По умолчанию только этот ПК.
LUMO_ALLOW_NETWORK=false
LUMO_TIMEZONE=Europe/Moscow
# Навыки через запятую, которые нужно отключить, например: forget_fact,set_reminder
LUMO_DISABLED_SKILLS=

# --- ПК-клиент ---
LUMO_CORE_URL=ws://127.0.0.1:8765/ws
LUMO_DEVICE_ID=desktop
# tiny / base / small / medium — больше = точнее, но медленнее
LUMO_STT_MODEL=small
# auto / cuda / cpu
LUMO_STT_DEVICE=auto
# Голос Silero: aidar, baya, kseniya, xenia, eugene
LUMO_TTS_SPEAKER=xenia
